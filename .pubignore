# -----------------------------------------------------------------------------
# Third-party i-mobile SDK binaries must never be included in a pub.dev archive.
# The SDK must be obtained directly by each user from i-mobile.
# -----------------------------------------------------------------------------
android/libs/*.jar
android/libs/*.aar
ios/Frameworks/
example/android/app/libs/*.jar
example/android/app/libs/*.aar
example/ios/Frameworks/
**/imobileSdkAds.jar
**/ImobileSdkAds.xcframework/
imobile_for_SP_app_*
**/imobile_for_SP_app_*

# Vendor/download archives
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

